# Copy this file to .env and fill in your keys. Never commit .env.

# Meta Model API (Muse Spark), used by both agents by default
META_API_KEY=your_key_here
# META_MODEL=muse-spark-1.3

# Optional: run the Saboteur on Meta's open-weight model (Muse Spark Open) via Baseten
# SABOTEUR_PROVIDER=baseten
# BASETEN_API_KEY=your_baseten_key
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional: any other OpenAI-compatible endpoint (e.g. Modal), then set SABOTEUR_PROVIDER=custom
# OPEN_API_BASE=https://your-endpoint/v1
# OPEN_API_KEY=...
# OPEN_MODEL=...

# Optional: lets BugBait open pull requests with the tests it writes
# GITHUB_TOKEN=github_pat_...
